{
  "name": "bridgesure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Compliance-continuous escrow demo for cross-border trade on Monad",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" build",
    "lint": "eslint . && pnpm run lint:sol",
    "lint:sol": "cd contracts && forge fmt --check",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" test",
    "test:e2e": "pnpm --filter @bridgesure/api test:e2e",
    "test:contracts": "cd contracts && forge test",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "cleanverse:smoke": "pnpm --filter @bridgesure/cleanverse smoke",
    "deploy:escrow": "cd contracts && forge build && cd .. && pnpm --filter @bridgesure/api provision:deploy-escrow",
    "provision": "pnpm --filter @bridgesure/api provision",
    "provision:apass": "pnpm --filter @bridgesure/api provision:apass",
    "provision:register-pool": "pnpm --filter @bridgesure/api provision:register-pool",
    "provision:grant": "pnpm --filter @bridgesure/api provision:grant",
    "provision:freeze-exporter": "pnpm --filter @bridgesure/api provision:freeze-exporter",
    "provision:unfreeze-exporter": "pnpm --filter @bridgesure/api provision:unfreeze-exporter",
    "provision:set-paused": "pnpm --filter @bridgesure/api provision:set-paused",
    "provision:verify-pool": "pnpm --filter @bridgesure/api provision:verify-pool",
    "provision:fund-escrow": "pnpm --filter @bridgesure/api provision:fund-escrow",
    "provision:submit-release": "pnpm --filter @bridgesure/api provision:submit-release"
  },
  "devDependencies": {
    "@bridgesure/config": "workspace:*",
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  },
}
