{
  "name": "@bridgesure/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BridgeSure API, compliance orchestration, and audit export",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@bridgesure/cleanverse": "workspace:*",
    "@bridgesure/domain": "workspace:*",
    "fastify": "^5.2.1",
    "viem": "^2.22.17",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@bridgesure/config": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
