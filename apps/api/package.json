{
  "name": "@bridgesure/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BridgeSure API, compliance orchestration, and audit export",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "provision": "tsx scripts/help.ts",
    "provision:apass": "tsx scripts/generate-apass.ts",
    "provision:register-pool": "tsx scripts/register-pool.ts",
    "provision:grant": "tsx scripts/grant-register-role.ts",
    "provision:freeze-exporter": "tsx scripts/freeze-exporter.ts",
    "provision:unfreeze-exporter": "tsx scripts/unfreeze-exporter.ts",
    "provision:set-paused": "tsx scripts/set-paused.ts",
    "provision:verify-pool": "tsx scripts/verify-pool.ts",
    "provision:deploy-escrow": "tsx scripts/deploy-escrow.ts",
    "provision:fund-escrow": "tsx scripts/fund-escrow.ts",
    "provision:submit-release": "tsx scripts/submit-release.ts"
  },
  "dependencies": {
    "@bridgesure/cleanverse": "workspace:*",
    "@bridgesure/domain": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.2.1",
    "viem": "^2.22.17",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@bridgesure/config": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
