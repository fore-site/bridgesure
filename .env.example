# Server-side only. Never expose these through a public/browser environment prefix.
CLEANVERSE_BASE_URL=https://uatapi.cleanverse.com/api/cooperate
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY=

# Demo resources to obtain or create in the sandbox.
BRIDGESURE_CHAIN=monad
BRIDGESURE_IMPORTER_ADDRESS=0x4aa29d0188d81A39cBd2BF11C1791aF3fF294E3A
BRIDGESURE_EXPORTER_ADDRESS=0xaABb93dA3999765dD48a40d70054190AE3361506
BRIDGESURE_ADMIN_ADDRESS=0x13cd068321C624d63C4A1d0eA2eBd806c22B9FA7
BRIDGESURE_ATOKEN_ADDRESS=
# Cleanverse IAPassComplianceValidator deployment for the selected chain.
BRIDGESURE_VALIDATOR_ADDRESS=0xaC7e5179C2C7f03f209136886c172eb34F161792
# The deployed BridgeSureEscrow becomes the registered validator pool. Keep this empty
# until deployment and registration have completed.
BRIDGESURE_ESCROW_ADDRESS=
# Optional only if Cleanverse supplies a separate pre-registered demo pool.
BRIDGESURE_VALIDATOR_POOL_ADDRESS=
