# Server-side only. Never expose these through a public/browser environment prefix.
CLEANVERSE_BASE_URL=https://uatapi.cleanverse.com/api/cooperate
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY=

# demo (default): scripted sandbox mock — no network, credentials, or funded
# wallet needed; ideal for the local console. Set to live to use the real
# Cleanverse transport with the API id/key above (requires sandbox resources).
BRIDGESURE_CLEANVERSE_MODE=demo

# Demo resources to obtain or create in the sandbox.
BRIDGESURE_CHAIN=monad
# Monad Testnet.
BRIDGESURE_CHAIN_ID=10143
BRIDGESURE_RPC_URL=https://testnet-rpc.monad.xyz
BRIDGESURE_IMPORTER_ADDRESS=0x4aa29d0188d81A39cBd2BF11C1791aF3fF294E3A
BRIDGESURE_EXPORTER_ADDRESS=0xaABb93dA3999765dD48a40d70054190AE3361506
BRIDGESURE_ADMIN_ADDRESS=0x13cd068321C624d63C4A1d0eA2eBd806c22B9FA7
# Discovered via /query_deposit_atoken_list (chain=monad): the only supported CVA pair.
# aUSDC A-Token is the escrow asset; origin USDC is informational.
BRIDGESURE_ATOKEN_ADDRESS=0xaC0893567D43C3E7e6e35a72803df05416C1f20D
BRIDGESURE_ORIGIN_TOKEN_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
BRIDGESURE_ACCESSCORE_ADDRESS=0x8F118338a1fa41E7Fa86Be19A4e8B99Ed58A6EcC
# Cleanverse IAPassComplianceValidator deployment for the selected chain.
BRIDGESURE_VALIDATOR_ADDRESS=0xaC7e5179C2C7f03f209136886c172eb34F161792
# The deployed BridgeSureEscrow becomes the registered validator pool. Keep this empty
# until deployment and registration have completed.
BRIDGESURE_ESCROW_ADDRESS=
# Optional only if Cleanverse supplies a separate pre-registered demo pool.
BRIDGESURE_VALIDATOR_POOL_ADDRESS=

# Release authorization signer. 0x + 64 hex chars; the server derives the signer
# address from this key. Generate a demo-only key (e.g. `cast wallet new`); never
# commit a real key.
BRIDGESURE_RELEASE_SIGNER_PRIVATE_KEY=

# --- Phase 5 live provisioning (optional; only needed for sandbox writes) ---
# Admin/deployer wallet: deploys the escrow, can hold, and submits releases.
BRIDGESURE_DEPLOYER_PRIVATE_KEY=
# Importer wallet: funds the escrow on-chain (approve + fund).
BRIDGESURE_IMPORTER_PRIVATE_KEY=
# Wallet holding validator REGISTER_ROLE: signs EIP-191 owner messages for
# `provision:register-pool` and `provision:grant`.
BRIDGESURE_VALIDATOR_OWNER_PRIVATE_KEY=

# Single trade configuration. The deployed escrow is immutably bound to the
# keccak of this identifier (escrow.tradeId()) — changing it requires a fresh
# escrow deployment + pool re-registration.
BRIDGESURE_TRADE_ID=bridgesure-demo-trade-001
# Seed synthetic demo trades on boot for dashboard content. Default is false:
# the live registry holds only the configured escrow-bound trade.
BRIDGESURE_SEED_DEMO_TRADES=false
# Base units (aUSDC has 6 decimals): 20 aUSDC + 20 aUSDC. The escrow must be
# funded with milestone one + milestone two; scale these to what the sandbox
# funding path can supply before the demo deadline.
BRIDGESURE_MILESTONE_ONE_AMOUNT=20000000
BRIDGESURE_MILESTONE_TWO_AMOUNT=20000000
# Freshness window for release evidence and authorization lifetime (seconds).
BRIDGESURE_EVIDENCE_AGE_LIMIT_SECONDS=300
BRIDGESURE_AUTH_EXPIRY_WINDOW_SECONDS=120
BRIDGESURE_NONCE_POOL_START=1
# Release-path retry for transient Cleanverse transport failures (network/timeout):
# attempts with exponential backoff (base ms, doubled per retry, plus jitter).
# Business rejections (paused pool, business code != 0000) are never retried.
BRIDGESURE_CLEANVERSE_RETRY_ATTEMPTS=3
BRIDGESURE_CLEANVERSE_RETRY_BASE_MS=400

# --- Automatic funding + release (server jobs, no operator click) ---
# Auto-fund: a server job watches the registry and funds DRAFT trades — on-chain
# from the importer key (live mode; only the configured escrow-bound trade) or
# mirrored to the registry (demo mode). Trades it cannot fund yet (importer
# balance below the total) are retried on later ticks; the reason is recorded
# once in the audit trail. Set to false to keep funding fully manual.
BRIDGESURE_AUTO_FUND_ENABLED=true
BRIDGESURE_AUTO_FUND_INTERVAL_MS=10000
# Auto-release: funded trades with anchored milestone evidence are released by
# the job once fresh A-Pass + validator checks pass (fail closed otherwise).
BRIDGESURE_AUTO_RELEASE_ENABLED=true
BRIDGESURE_AUTO_RELEASE_INTERVAL_MS=10000
BRIDGESURE_PORT=4000
# Browser origin allowed to call the API directly (apps/web console).
BRIDGESURE_WEB_ORIGIN=http://localhost:3000

# --- Trade registry persistence (never hardcoded — driven by env) ---
# Postgres via a connection string (Supabase, Neon, any PG). Providing one
# selects the postgres driver automatically — no other DB config needed.
# From Supabase: Project Settings -> Database -> Connection string.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# BRIDGESURE_DB_URL=   (alternative name; DATABASE_URL wins if both are set)
#
# TLS is auto-enabled for Supabase hosts and for any ?sslmode=require in the
# string; disable with ?sslmode=disable or override explicitly:
# BRIDGESURE_DB_SSL=false
#
# Explicitly select the driver (overrides inference, e.g. force sqlite while
# a DATABASE_URL is present):
# BRIDGESURE_DB_DRIVER=sqlite
#
# SQLite fallback (used when no connection string is set):
# BRIDGESURE_DB_FILE=./data/bridgesure.sqlite
