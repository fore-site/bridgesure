{
  "name": "@bridgesure/cleanverse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed Cleanverse transport, AES encryption, runtime schemas, and mocks",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mocks": {
      "types": "./dist/mocks/index.d.ts",
      "import": "./dist/mocks/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node --experimental-strip-types src/smoke.ts"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@bridgesure/config": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
